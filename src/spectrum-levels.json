  "prism_red_azure_wave_plus": {
    "name": "光谱·碧波·强化",
    "max_level": 1,
    "fields": [],
    "description": "红色光谱。装填后，自身的【碧波】强化为【碧波+】：对敌方全体造成施术者最大生命值 10% + 0.75 倍攻击力的水属性伤害，随后使其水属性抗性降低 20%，持续 100 行动值（重复施加时刷新持续时间）；只命中 1 名敌人时，伤害与抗性降低幅度均提高 50%。之后使生命值比例最低的友方（优先未满生命值者）回复等同于造成总伤害的生命值。需要 30 点水元素亲和力方可装填。"
  },
  "prism_blue_iron_defense_plus": {
    "name": "光谱·铁壁·强化",
    "max_level": 1,
    "fields": [],
    "description": "蓝色光谱。装填后，自身的【铁壁】强化为【铁壁+】：自身减伤率提升 30%，持续 5 回合；并每回合回复自身 8% 最大生命值，持续 3 回合（施放时立即回复一次，共 4 次）。需要 30 点地元素亲和力方可装填。"
  },
  "prism_blue_holy_light_plus": {
    "name": "光谱·圣光·强化",
    "max_level": 1,
    "fields": [],
    "description": "蓝色光谱。装填后，自身的【圣光】强化为【圣光+】：使未满生命值的友方中生命值比例最低者（全员满生命值时为生命值比例最低者）回复等同于施术者 20% 最大生命值 + 100% 攻击力的生命值；随后使其他友方获得等同于施术者基础攻击力 (20 + 幸运 × 0.2)% 的固定攻击力加成，持续 100 行动值（重复施加时刷新持续时间）。需要 30 点光元素亲和力方可装填。"
  },
  "prism_red_shadow_sneak_plus": {
    "name": "光谱·影子偷袭·强化",
    "max_level": 1,
    "fields": [],
    "description": "红色光谱。装填后，自身的【影子偷袭】强化为【影子偷袭+】：消耗自身当前生命值的 (30 - 0.5 × 暗元素亲和)%，对当前生命值最低的敌人造成 2.0 倍攻击力的暗属性伤害，并使其减伤率降低 10%，持续 100 行动值（重复施加时刷新持续时间）。需要 30 点暗元素亲和力方可装填。"
  },
